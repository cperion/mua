-- Blocks as arguments: the trailing colon, activities that own their completion, `endall`.
--   luajit mua.lua examples/blocks.mua

-- A function that takes a block is an activity: it sets up, runs the block, and completes.
local with_log = do(title) = do(body)
    print("begin " .. title)
    body
    print("end " .. title)
end

-- The trailing colon opens a block that takes the home (`do(..)`); no parentheses.
with_log "import":
    print "  reading"
    print "  writing"
end

-- A block's parameters are the do lambda's parameters.
local each = do(items) = do(body)
    for i, item in ipairs items do body(i, item) end
end

each { "a", "b", "c" } do(index, item)
    print(index, item)
end

-- Activities stack, and `endall` closes the whole spine at once.
local timed = do(label) = do(body)
    print("start " .. label)
    body
    print("stop " .. label)
end

with_log "outer" do
timed "inner" do
    print "  the work"
endall

-- `do(...)` assigns a block, here as a handler in a table.
local handlers = {
    greet = do(name)
        print("hello, " .. name)
    end,
}
handlers.greet "blocks"

--[=[ output
begin import
  reading
  writing
end import
1	a
2	b
3	c
begin outer
start inner
  the work
stop inner
end outer
hello, blocks
]=]
