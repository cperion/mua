-- A graph-review language: assemble, describe commands, draw, and complete file choices.
local ffi = require "ffi"
local Ui = require "bui.ui"
local Native = require("bui.ffi").load(arg[1] or ("./build/bui/" ..
        (ffi.os == "Windows" and "mua_bui.dll" or "libmua_bui.so")))

-- The form owns a draft, not the document. Finish is its terminal destination, supplied
-- before placement; only the caller's accepted arm changes the document after teardown.
local title_form = do(initial_title) = do(Finish) = do(..)
    local Title = text { value = initial_title }
    local Problem = label ""
    local accept = do()
        local title = Title.current()
        if title == "" then Problem.display "Enter a title"; return end
        Finish.accept title
    end
    row { spacing = 8 }:
        button "Apply title" accept
        button "Keep current title" Finish.cancel
    end
    return define
        replace = Title.set
        current = Title.current
        .accept
    end
end

-- A reusable component owns its interaction state. Services and painting are different
-- synchronous vocabularies; neither is an ordinary notification or a mounting context.
local preview = do(Notify)
    assert(type Notify.status == "function", "preview needs a status notification")
    local Notify = define status = Notify.status end
    return do(..)
        local touches = 0
        panel "Synchronous drawing, deferred notification":
            local Preview = custom { height = 100 }
            local behavior = Ui.behavior:
                natural_size { width = 650, height = 100 }
                when_pressed do(pointer) = do(..)
                    touches = touches + 1
                    invalidate
                    local message = "Preview pressed " .. touches .. " times"
                    notify_later Notify.status message
                    return Ui.Input.consumed()
                end
                paint do(bounds) = do(..)
                    rectangle { ..bounds, color = { 0.07, 0.12, 0.2, 1 } }
                    circle with
                        x = bounds.x + bounds.width / 2
                        y = bounds.y + bounds.height / 2
                        radius = 20 + touches % 10
                        color = { 0.2, 0.75, 0.6, 1 }
                    end
                end
            end
            Preview.behave behavior
        end
    end
end

local workspace = do(inputs)
    local initial_title = inputs.title
    assert(type initial_title == "string", "workspace needs a document title")
    return do(Notify)
        assert(type Notify.status == "function", "workspace needs a status notification")
        local Notify = define status = Notify.status end
        return do(..)
            local Graph, Source, Output, Browser
            local document_title = initial_title
            local refresh = do()
                Browser.replace_forest(Ui.forest {
                        { id = "document", label = document_title, expanded = true, children = {
                                { id = "source", label = "Source" },
                                { id = "output", label = "Output" },
                            } },
                    })
                Notify.status "Document refreshed"
            end
            local choose_document = do()
                choose_file { title = "Choose a document", browser = { directory = "." } } do(result)
                    result with
                        accepted = paths -> Notify.status("Selected " .. table.concat(paths, ", "))
                        cancelled = || -> Notify.status "File choice cancelled"
                    end
                end {
                    opened() = nil,
                    unavailable = Notify.status,
                }
            end
            local review_title = do()
                local completed = do(outcome)
                    outcome with
                        accepted = do(title)
                            document_title = title
                            refresh
                        end
                        cancelled = || -> Notify.status "Current title kept"
                    end
                end
                local options = { title = "Review the title", width = 380, height = 160 }
                local form = title_form document_title
                return open_dialog options completed form
            end
            local request_review = do()
                review_title() { opened() = nil, unavailable = Notify.status }
            end
            local Commands = Ui.menu:
                item { caption = "Refresh", action = refresh }
                item { caption = "Review title", action = request_review }
                item { caption = "Choose file", action = choose_document }
            end
            row { spacing = 12 }:
                local Document = menu_button "Document"
                Document.menu Commands
                button "Fit graph" do() Graph.fit_view end
            end
            row { spacing = 12, fill = true }:
                Browser = tree { width = 180, height = 280 }
                Browser.connect define
                    changed = do(selection)
                        selection with
                            selected = item -> Notify.status("Selected " .. item.label)
                            empty() = nil
                        end
                    end
                end
                Graph = node_editor { width = 500, height = 280 }:
                    Source = graph_node { caption = "Source", x = 25, y = 25 }
                    local source_sockets = Ui.sockets:
                        output { caption = "Color", type = "color" }
                        input { caption = "Exposure", type = "float", value = 1 }
                    end
                    Source.set_sockets source_sockets
                    Output = graph_node { caption = "Output", x = 280, y = 70 }
                    local output_sockets = Ui.sockets:
                        input { caption = "Color", type = "color" }
                    end
                    Output.set_sockets output_sockets
                end
                Graph.set_links { { from = Source, output = 1, to = Output, input = 1 } }
            end
            local identities = {[Source.graph_identity()] = Source,
                [Output.graph_identity()] = Output }
            local Changes = define
                moved = state -> Notify.status(string.format("Moved node to %.0f, %.0f",
                        state.x, state.y))
                selection = state -> Notify.status(state.selected and "Node selected" or "Node deselected")
                input = change -> Notify.status("Edited input " .. change.index)
                collapsed = state -> Notify.status(state.collapsed and "Node collapsed" or "Node expanded")
                links = links -> Notify.status("Graph has " .. #links .. " links")
                deletion = do(states)
                    for _, state in ipairs states do
                        local Node = identities[state.id]
                        if Node then Graph.remove_node Node; identities[state.id] = nil end
                    end
                    Notify.status "Selected nodes removed"
                end
                order = || -> Notify.status "Graph stacking order changed"
            end
            local changed = change -> change Changes
            Source.connect { .changed }
            Output.connect { .changed }
            Graph.connect { .changed }
            include(preview Notify)
            refresh
            return define
                .refresh
                .choose_document
                .review_title
                document_title = || -> document_title
            end
        end
    end
end

Ui.with_application Native:
    gpu_default false
    theme "dark"
    local headless = arg[2] == "--headless"
    local open = headless and with_surface or with_window
    open { title = "Mua / graph review", width = 760, height = 600 }:
        with_content:
            label { caption = "Graph review", bold = true, font_scale = 1.5 }
            local Status = label "Ready"
            local review = workspace { title = "Example document" }
            return include(review define status = Status.display end)
        end do(..)
            -- refresh comes from the component; bind_keys comes from the window.
            local shortcuts = Ui.keymap:
                bind "Ctrl+r" refresh
            end
            bind_keys shortcuts
            if headless or arg[2] == "--smoke" then
                local original_title = document_title()
                local cancelled = review_title() with
                    opened = value -> value
                    unavailable = reason -> error reason
                end
                cancelled.content.replace "Discard this draft"
                cancelled.cancel
                pump
                assert(document_title() == original_title)
                local accepted = review_title() with
                    opened = value -> value
                    unavailable = reason -> error reason
                end
                accepted.content.replace ""
                accepted.content.accept
                assert(accepted.content.current() == "" and document_title() == original_title)
                accepted.content.replace "Reviewed document"
                accepted.content.accept
                assert(document_title() == original_title)
                pump
                assert(document_title() == "Reviewed document")
            end
            if headless then
                render
                pump
                render
            else
                show
                if arg[2] == "--smoke" then after 250 close end
                run
            end
        end
    end { opened() = print "BUI workbench completed.", unavailable = reason -> error reason }
end
