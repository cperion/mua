-- Activities own the work; opened vocabularies supply the instructions inside it.
-- luajit mua.lua examples/bui/activities.mua path/to/mua_bui.dll [--smoke|--headless]
local ffi = require "ffi"
local Ui = require "bui.ui"
local filename = ffi.os == "Windows" and "mua_bui.dll" or "libmua_bui.so"
local Native = require("bui.ffi").load(arg[1] or "./build/bui/" .. filename)

-- Inputs and outward notifications stay explicit. The returned installer opens placement;
-- its returned vocabulary is the parent's inward access, not the implementation's controls.
local counter_panel = do(inputs)
    local initial, caption = inputs.initial, inputs.caption
    assert(type initial == "number" and initial >= 0 and initial <= 20)
    assert(type caption == "string", "counter needs a caption")
    return do(Notify)
        assert(type Notify.changed == "function", "counter needs a changed continuation")
        local Notify = define changed = Notify.changed end
        return do(..)
            local value = initial
            local Readout, Slider
            local set_count = do(count)
                value = math.max(0, math.min(20, count))
                Readout.display(string.format("Count / %d", value))
                Slider.set value
                Notify.changed value
            end
            local increment = || -> set_count(value + 1)
            box { padding = 16, spacing = 10, fill = true }:
                label { .caption, bold = true, font_scale = 1.2 }
                Readout = label(string.format("Count / %d", value))
                Slider = slider with
                    minimum = 0
                    maximum = 20
                    .value
                    integer = true
                    precision = 0
                end
                Slider.connect define changed = set_count end
                button "Increment" increment
                button "Reset" (|| -> set_count initial)
            end
            return define .increment, current = || -> value end
        end
    end
end

-- Description building is pure; canvas publication is a separate instruction.
local landscape = do(Badge) = do(size)
    local width, height = size.width, size.height
    return Ui.drawing:
        rectangle with
            coordinates = { 0, 0, width, height }
            fill = { 0.06, 0.12, 0.24, 1 }
        end
        oval with
            coordinates = { width * 0.68, 15, width * 0.68 + 54, 69 }
            fill = { 1, 0.73, 0.4, 1 }
        end
        polygon with
            coordinates = { 0, height, width * 0.3, 25, width * 0.6, height }
            fill = { 0.22, 0.45, 0.55, 1 }
        end
        polygon with
            coordinates = { width * 0.3, height, width * 0.7, 55, width, height }
            fill = { 0.1, 0.3, 0.4, 1 }
        end
        image with
            coordinates = { width - 40, height - 40, width - 16, height - 16 }
            image = Badge
        end
    end
end

local studio = do(..)
    local First, Second
    column { padding = 20, spacing = 14, fill = true }:
        label { caption = "Mua / activities", font_scale = 1.7, bold = true }
        label "Two components. Independent state. Explicit parent wiring."
        local Status = label "Ready"
        local Notifications = define
            changed = value -> Status.display(string.format("A counter reported %d", value))
        end
        local first_panel = counter_panel { caption = "First counter", initial = 4 }
        local second_panel = counter_panel { caption = "Second counter", initial = 10 }
        row { spacing = 16 }:
            First = include(first_panel Notifications)
            Second = include(second_panel Notifications)
        end
        -- These subjects are intentionally named: the command addresses both children.
        button "Advance both" do()
            First.increment
            Second.increment
        end
        -- This instruction resolves to the column's resources, not the application's.
        local Badge = resources.acquire_image with
            width = 2
            height = 2
            rgba = string.char(255, 186, 102, 255, 56, 115, 140, 255,
                26, 77, 102, 255, 232, 238, 245, 255)
        end {
            ready(image) = image,
            unavailable(reason) = error reason,
        }
        local Canvas = canvas { height = 140, fill = true }
        Canvas.connect define
            configured = bounds -> Canvas.replace(landscape Badge bounds)
        end
        local Note = slot {}
        button "Replace the note" do()
            Note.replace:
                label "This child has its own mount lifetime. Its predecessor was retired safely."
            end
        end
        Note.replace:
            label "The native driver owns dispatch. Components never enter a nested event loop."
        end
    end
    return define
        advance_first = First.increment
        first_count = First.current
        second_count = Second.current
    end
end

Ui.with_application Native:
    gpu_default false
    theme "dark"
    local headless = arg[2] == "--headless"
    local open = headless and with_surface or with_window
    return open { title = "Mua / activity-based BUI", width = 850, height = 650 }:
        with_content studio:
            advance_first
            assert(first_count() == 5 and second_count() == 10)
            if headless then
                render
                pump
                render
            else
                show
                if arg[2] == "--smoke" then after 200 close end
                run
            end
        end
    end {
        opened() = print "BUI activity example completed.",
        unavailable = reason -> error(reason, 0),
    }
end
