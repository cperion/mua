-- A small Lisp, compiled to Lua: read, parse to a syntax tree, check, lower to instructions,
-- optimize, emit. Two closed families (the syntax and the instructions) and a pass over one of
-- them for every stage; passes are vocabularies, so they share and extend one another by spread.
-- docs/writing-compilers.md builds the same compiler step by step, with source positions and
-- every problem reported at once.
--   luajit mua.lua examples/lisp.mua

------------------------------------------------------------------------------------------------
-- Reading: text to data. A number is a number, a symbol a string, a list a table.

local read =: text
    local spaced = text:gsub("%(", " ( "):gsub("%)", " ) ")
    local tokens = {}
    for token in spaced:gmatch "%S+" do tokens[#tokens + 1] = token end
    local position = 1
    local read_datum
    read_datum = do()
        local token = tokens[position]
        position += 1
        if token == nil then error("read: the text ends inside a list", 0) end
        if token == ")" then error("read: a ) closes nothing", 0) end
        if token ~= "(" then return tonumber token or token end
        local items = {}
        while tokens[position] ~= ")" do
            if tokens[position] == nil then error("read: a ( is never closed", 0) end
            items[#items + 1] = read_datum()
        end
        position += 1
        return items
    end
    local forms = {}
    while tokens[position] ~= nil do forms[#forms + 1] = read_datum() end
    return forms
end

------------------------------------------------------------------------------------------------
-- The source language: a family of expression kinds.

local Expression = family "expression of the source language"
local Literal = struct { value: Number }
local Variable = struct { name: String }
local Primitive = struct { operator: String, arguments: Table }
local Conditional = struct { condition: Expression, when_true: Expression, when_false: Expression }
local Let = struct { name: String, value: Expression, body: Expression }
local Lambda = struct { parameters: Table, body: Expression }
local Application = struct { callee: Expression, arguments: Table }
Expression { Literal, Variable, Primitive, Conditional, Let, Lambda, Application }

local operators = {
    ["+"] = |left, right| -> left + right,
    ["-"] = |left, right| -> left - right,
    ["*"] = |left, right| -> left * right,
    ["<"] = |left, right| -> left < right,
    ["="] = |left, right| -> left == right,
}

-- Parsing: data to the family. A `let` binding sees itself, so a function can recur.
local parse
parse =: datum
    if type datum == "number" then return Literal { value = datum } end
    if type datum == "string" then return Variable { name = datum } end
    local head = datum[1]
    if head == "if" then
        if #datum ~= 4 then
            error("parse: (if condition when-true when-false) takes three parts", 0)
        end
        return Conditional with
            condition = parse datum[2]
            when_true = parse datum[3]
            when_false = parse datum[4]
        end
    end
    if head == "let" then
        local body = parse datum[3]
        for index = #datum[2], 1, -1 do
            local binding = datum[2][index]
            body = Let { name = binding[1], value = parse binding[2], .body }
        end
        return body
    end
    if head == "lambda" then return Lambda { parameters = datum[2], body = parse datum[3] } end
    local arguments = {}
    for index = 2, #datum do arguments[#arguments + 1] = parse datum[index] end
    if operators[head] then return Primitive { operator = head, .arguments } end
    return Application { callee = parse datum[1], .arguments }
end

-- A program is some (define name value) forms and then the expression they are for.
local parse_program =: forms
    local body = parse forms[#forms]
    for index = #forms - 1, 1, -1 do
        local form = forms[index]
        if form[1] ~= "define" then error("parse: only the last form may be an expression", 0) end
        body = Let { name = form[2], value = parse form[3], .body }
    end
    return body
end

------------------------------------------------------------------------------------------------
-- Checking: a pass that carries the names in scope, and stops at the first problem.

local within = outer -> meta { index = outer } {}
local scope_with =: outer names
    local inner = within outer
    for _, name in ipairs names do inner[name] = true end
    return inner
end

local Checking = define
    Literal =: literal check scope
        return
    end
    Variable =: variable check scope
        if not scope[variable.name] then error("check: " .. variable.name .. " is not defined here",
                0) end
    end
    Primitive =: primitive check scope
        if #primitive.arguments ~= 2 then
            local message = ("(%s) takes two arguments, got %d"):format(primitive.operator,
                #primitive.arguments)
            error("check: " .. message, 0)
        end
        for _, argument in ipairs primitive.arguments do check(argument, scope) end
    end
    Conditional =: conditional check scope
        check(conditional.condition, scope)
        check(conditional.when_true, scope)
        check(conditional.when_false, scope)
    end
    Let =: let check scope
        local inner = scope_with(scope, { let.name })
        check(let.value, inner)
        check(let.body, inner)
    end
    Lambda =: lambda check scope
        check(lambda.body, scope_with(scope, lambda.parameters))
    end
    Application =: application check scope
        check(application.callee, scope)
        for _, argument in ipairs application.arguments do check(argument, scope) end
    end
end
local check = Expression.pass "check names and arity" with ..Checking end

-- The same family, run directly: the reference the compiled code is compared with.
local Evaluation = define
    Literal =: literal evaluate environment
        return literal.value
    end
    Variable =: variable evaluate environment
        return environment[variable.name]
    end
    Primitive =: primitive evaluate environment
        local left = evaluate(primitive.arguments[1], environment)
        local right = evaluate(primitive.arguments[2], environment)
        return operators[primitive.operator](left, right)
    end
    Conditional =: conditional evaluate environment
        if evaluate(conditional.condition, environment) then
            return evaluate(conditional.when_true, environment)
        end
        return evaluate(conditional.when_false, environment)
    end
    Let =: let evaluate environment
        local inner = within environment
        inner[let.name] = evaluate(let.value, inner)
        return evaluate(let.body, inner)
    end
    Lambda =: lambda evaluate environment
        return do(..arguments)
            local inner = within environment
            for index, name in ipairs lambda.parameters do inner[name] = arguments[index] end
            return evaluate(lambda.body, inner)
        end
    end
    Application =: application evaluate environment
        local arguments = {}
        for index, argument in ipairs application.arguments do
            arguments[index] = evaluate(argument, environment)
        end
        return evaluate(application.callee, environment)(unpack arguments)
    end
end
local evaluate = Expression.pass "evaluate the source directly" with ..Evaluation end

------------------------------------------------------------------------------------------------
-- The intermediate form: registers and jumps, one list of instructions per function.

local Instruction = family "instruction of the intermediate form"
local Constant = struct { register: String, value: Any }
local Copy = struct { register: String, source: String }
local Operation = struct { register: String, operator: String, left: String, right: String }
local Call = struct { register: String, callee: String, arguments: Table }
local Label = struct { name: String }
local Jump = struct { label: String }
local JumpUnless = struct { condition: String, label: String }
local Return = struct { source: String }
local Closure = struct { register: String, parameters: Table, code: Table }
Instruction { Constant, Copy, Operation, Call, Label, Jump, JumpUnless, Return, Closure }

-- fresh names say what a register holds: `value_3`, `fact_1` (the register of `fact`), `otherwise_4`
local fresh_names = do()
    local count = 0
    return: word
        count += 1
        return word:gsub("[^%w_]", "_") .. "_" .. count
    end
end

local write_instruction =: lowering instruction
    lowering.code[#lowering.code + 1] = instruction
end

-- Lowering: a pass from one family to the other. The lowering state holds the code being written,
-- the register each name stands for, and the supply of fresh names.
local Lowering = define
    Literal =: literal lower lowering
        local register = lowering.fresh "value"
        write_instruction(lowering, Constant { .register, value = literal.value })
        return register
    end
    Variable =: variable lower lowering
        return lowering.registers[variable.name]
    end
    Primitive =: primitive lower lowering
        local left = lower(primitive.arguments[1], lowering)
        local right = lower(primitive.arguments[2], lowering)
        local register = lowering.fresh "value"
        local operator = primitive.operator
        write_instruction(lowering, Operation { .register, .operator, .left, .right })
        return register
    end
    Conditional =: conditional lower lowering
        local condition = lower(conditional.condition, lowering)
        local otherwise = lowering.fresh "otherwise"
        local done = lowering.fresh "done"
        local register = lowering.fresh "value"
        write_instruction(lowering, JumpUnless { .condition, label = otherwise })
        write_instruction(lowering,
            Copy { .register, source = lower(conditional.when_true, lowering) })
        write_instruction(lowering, Jump { label = done })
        write_instruction(lowering, Label { name = otherwise })
        write_instruction(lowering,
            Copy { .register, source = lower(conditional.when_false, lowering) })
        write_instruction(lowering, Label { name = done })
        return register
    end
    Let =: let lower lowering
        local register = lowering.fresh let.name
        local inner = { ..lowering, registers = within lowering.registers }
        inner.registers[let.name] = register
        write_instruction(lowering, Copy { .register, source = lower(let.value, inner) })
        return lower(let.body, inner)
    end
    Lambda =: lambda lower lowering
        local inner = { ..lowering, code = {}, registers = within lowering.registers }
        local parameters = {}
        for index, name in ipairs lambda.parameters do
            parameters[index] = lowering.fresh name
            inner.registers[name] = parameters[index]
        end
        write_instruction(inner, Return { source = lower(lambda.body, inner) })
        local register = lowering.fresh "lambda"
        write_instruction(lowering, Closure { .register, .parameters, code = inner.code })
        return register
    end
    Application =: application lower lowering
        local callee = lower(application.callee, lowering)
        local arguments = {}
        for index,
        argument in ipairs application.arguments do arguments[index] = lower(argument, lowering) end
        local register = lowering.fresh "value"
        write_instruction(lowering, Call { .register, .callee, .arguments })
        return register
    end
end
local lower = Expression.pass "lower the source to instructions" with ..Lowering end

-- Optimizing. A rewrite answers each instruction with the instructions that replace it, so
-- `Unchanged` (every instruction stands for itself) is the base the others extend by spread, and
-- each names only the kinds it changes.
local itself = instruction -> { instruction }
local Unchanged = define
    Constant = itself
    Copy = itself
    Operation = itself
    Call = itself
    Label = itself
    Jump = itself
    JumpUnless = itself
    Return = itself
    Closure = itself
end
local nothing = do() end

local rewrite =: pass code state
    local written = {}
    state.written = written
    for _, instruction in ipairs code do
        for _, replacement in ipairs(pass(instruction, state)) do
            written[#written + 1] = replacement
        end
    end
    return written
end
local walk =: pass code state
    for _, instruction in ipairs code do pass(instruction, state) end
end

-- Folding: what a register holds is known from its Constant, along straight-line code. A join
-- point (a label) forgets it, and a function starts knowing nothing.
local Folding = define ..Unchanged
    Constant =: constant fold facts
        facts.known[constant.register] = { constant.value }
        return { constant }
    end
    Copy =: copy fold facts
        local known = facts.known[copy.source]
        facts.known[copy.register] = known
        if known then return { Constant { register = copy.register, value = known[1] } } end
        return { copy }
    end
    Operation =: operation fold facts
        local left, right = facts.known[operation.left], facts.known[operation.right]
        facts.known[operation.register] = nil
        if left and right then
            local value = operators[operation.operator](left[1], right[1])
            facts.known[operation.register] = { value }
            return { Constant { register = operation.register, .value } }
        end
        return { operation }
    end
    Call =: call fold facts
        facts.known[call.register] = nil
        return { call }
    end
    Label =: label fold facts
        facts.known = {}
        return { label }
    end
    JumpUnless =: jump fold facts
        local condition = facts.known[jump.condition]
        if condition == nil then return { jump } end
        if condition[1] then return {} end
        return { Jump { label = jump.label } }
    end
    Closure =: closure fold facts
        facts.known[closure.register] = nil
        local code = rewrite(fold, closure.code, { known = {} })
        return { Closure { register = closure.register, parameters = closure.parameters, .code } }
    end
end
local fold = Instruction.pass "fold what is known" with ..Folding end

-- Which labels are still jumped to.
local JumpedTo = define
    Constant = nothing
    Copy = nothing
    Operation = nothing
    Call = nothing
    Label = nothing
    Return = nothing
    Jump =: jump find_labels labels
        labels[jump.label] = true
    end
    JumpUnless =: jump find_labels labels
        labels[jump.label] = true
    end
    Closure =: closure find_labels labels
        walk(find_labels, closure.code, labels)
    end
end
local find_labels = Instruction.pass "find the labels still jumped to" with ..JumpedTo end

-- Reaching: nothing runs between a jump and the next label that is jumped to, and a jump to the
-- label right after it is no jump.
local unless_dead =: instruction reach flow
    if flow.dead then return {} end
    return { instruction }
end
local ending_the_flow =: instruction reach flow
    if flow.dead then return {} end
    flow.dead = true
    return { instruction }
end
local Reaching = define
    Constant = unless_dead
    Copy = unless_dead
    Operation = unless_dead
    Call = unless_dead
    JumpUnless = unless_dead
    Jump = ending_the_flow
    Return = ending_the_flow
    Label =: label reach flow
        if not flow.labels[label.name] then return {} end
        local previous = flow.written[#flow.written]
        if previous and Instruction.is(previous, Jump) and previous.label == label.name then
            flow.written[#flow.written] = nil
        end
        flow.dead = false
        return { label }
    end
    Closure =: closure reach flow
        if flow.dead then return {} end
        local code = rewrite(reach, closure.code, { labels = flow.labels })
        return { Closure { register = closure.register, parameters = closure.parameters, .code } }
    end
end
local reach = Instruction.pass "drop what cannot run" with ..Reaching end

-- Reading: how often each register is read, then the removal of pure instructions nobody reads.
local read_once_more =: register counts
    counts.reads[register] = (counts.reads[register] or 0) + 1
end
local Reads = define
    Constant = nothing
    Label = nothing
    Jump = nothing
    Copy =: copy count_reads counts
        read_once_more(copy.source, counts)
    end
    Operation =: operation count_reads counts
        read_once_more(operation.left, counts)
        read_once_more(operation.right, counts)
    end
    Call =: call count_reads counts
        read_once_more(call.callee, counts)
        for _, argument in ipairs call.arguments do read_once_more(argument, counts) end
    end
    JumpUnless =: jump count_reads counts
        read_once_more(jump.condition, counts)
    end
    Return =: returning count_reads counts
        read_once_more(returning.source, counts)
    end
    Closure =: closure count_reads counts
        walk(count_reads, closure.code, counts)
    end
end
local count_reads = Instruction.pass "count the reads of each register" with ..Reads end

local never_read =: instruction counts
    return (counts.reads[instruction.register] or 0) == 0
end
local unless_never_read =: instruction sweep counts
    if never_read(instruction, counts) then return {} end
    return { instruction }
end
local Sweeping = define ..Unchanged
    Constant = unless_never_read
    Copy = unless_never_read
    Operation = unless_never_read
    Closure =: closure sweep counts
        if never_read(closure, counts) then return {} end
        local code = rewrite(sweep, closure.code, counts)
        return { Closure { register = closure.register, parameters = closure.parameters, .code } }
    end
end
local sweep = Instruction.pass "sweep what nobody reads" with ..Sweeping end

local instruction_count
instruction_count =: code
    local total = 0
    for _, instruction in ipairs code do
        total += 1
        if Instruction.is(instruction, Closure) then total += instruction_count instruction.code end
    end
    return total
end

local optimize =: code
    for _ = 1, 8 do
        local before = instruction_count code
        code = rewrite(fold, code, { known = {} })
        local labels = {}
        walk(find_labels, code, labels)
        code = rewrite(reach, code, { .labels })
        local counts = { reads = {} }
        walk(count_reads, code, counts)
        code = rewrite(sweep, code, counts)
        if instruction_count code == before then break end
    end
    return code
end

------------------------------------------------------------------------------------------------
-- Listing and emitting: passes that answer with text.

local Listing = define
    Constant =: constant list indent
        return indent .. constant.register .. " = " .. tostring constant.value
    end
    Copy =: copy list indent
        return indent .. copy.register .. " = " .. copy.source
    end
    Operation =: operation list indent
        local expression = operation.left .. " " .. operation.operator .. " " .. operation.right
        return indent .. operation.register .. " = " .. expression
    end
    Call =: call list indent
        local arguments = table.concat(call.arguments, ", ")
        return indent .. call.register .. " = " .. call.callee .. "(" .. arguments .. ")"
    end
    Label =: label list indent
        return indent .. label.name .. ":"
    end
    Jump =: jump list indent
        return indent .. "jump " .. jump.label
    end
    JumpUnless =: jump list indent
        return indent .. "jump " .. jump.label .. " unless " .. jump.condition
    end
    Return =: returning list indent
        return indent .. "return " .. returning.source
    end
    Closure =: closure list indent
        local parameters = table.concat(closure.parameters, ", ")
        local lines = { indent .. closure.register .. " = function(" .. parameters .. ")" }
        for _,
        instruction in ipairs closure.code do lines[#lines + 1] = list(instruction,
                indent .. "    ") end
        return table.concat(lines, "\n")
    end
end
local list_instruction = Instruction.pass "list an instruction for reading" with ..Listing end
local listing =: code
    local lines = {}
    for _, instruction in ipairs code do lines[#lines + 1] = list_instruction(instruction, "  ") end
    return table.concat(lines, "\n")
end

-- Emitting Lua: the registers a function writes are declared first, so a jump never enters the
-- scope of a local. The listing's spelling serves where Lua's is the same.
local function_body =: write code indent
    local registers, declared = {}, {}
    for _, instruction in ipairs code do
        local register = instruction.register
        if register and not declared[register] then
            declared[register] = true
            registers[#registers + 1] = register
        end
    end
    local lines = {}
    if #registers > 0 then lines[1] = indent .. "local " .. table.concat(registers, ", ") end
    for _, instruction in ipairs code do lines[#lines + 1] = write(instruction, indent) end
    return table.concat(lines, "\n")
end
local lua_spelling = {["="] = "==" }
local LuaText = define ..Listing
    Operation =: operation write indent
        local operator = lua_spelling[operation.operator] or operation.operator
        local expression = operation.left .. " " .. operator .. " " .. operation.right
        return indent .. operation.register .. " = " .. expression
    end
    Label =: label write indent
        return indent .. "::" .. label.name .. "::"
    end
    Jump =: jump write indent
        return indent .. "goto " .. jump.label
    end
    JumpUnless =: jump write indent
        return indent .. "if not " .. jump.condition .. " then goto " .. jump.label .. " end"
    end
    Closure =: closure write indent
        local parameters = table.concat(closure.parameters, ", ")
        local header = indent .. closure.register .. " = function(" .. parameters .. ")"
        local body = function_body(write, closure.code, indent .. "  ")
        return header .. "\n" .. body .. "\n" .. indent .. "end"
    end
end
local write_lua = Instruction.pass "write an instruction as Lua" with ..LuaText end
local emit_lua = code -> function_body(write_lua, code, "")

------------------------------------------------------------------------------------------------
-- The compiler: the stages in order. `compile` answers the tree, the instructions before and
-- after optimizing, and the Lua it emits.

local compile =: text
    local tree = parse_program(read text)
    check(tree, {})
    local lowering = { code = {}, registers = {}, fresh = fresh_names() }
    write_instruction(lowering, Return { source = lower(tree, lowering) })
    local optimized = optimize lowering.code
    return { .tree, instructions = lowering.code, .optimized, lua = emit_lua optimized }
end

local run =: text
    local compiled = compile text
    local value = load(compiled.lua, "=compiled")()
    return value, evaluate(compiled.tree, {}), compiled
end

local programs = {
    { title = "a constant condition folds away", source = "(if (< 1 2) (+ 10 (* 2 3)) 99)" },
    { title = "a function and a call",
        source = "(define square (lambda (x) (* x x))) (square (+ 3 4))" },
    { title = "recursion",
        source = "(define fact (lambda (n) (if (< n 2) 1 (* n (fact (- n 1)))))) (fact 10)" },
    { title = "a closure",
        source = "(define adder (lambda (a) (lambda (b) (+ a b)))) ((adder 3) 4)" },
}
for _, program in ipairs programs do
    local compiled_value, evaluated_value, compiled = run program.source
    local before, after = instruction_count compiled.instructions, instruction_count compiled.optimized
    local sizes = before .. " -> " .. after
    local values = "compiled " .. tostring compiled_value .. ", evaluated " .. tostring evaluated_value
    print(program.title .. ": " .. values .. ", " .. sizes .. " instructions")
end

local folded = compile programs[1].source
print "instructions before optimizing:"
print(listing folded.instructions)
print "after:"
print(listing folded.optimized)
print "emitted Lua:"
print folded.lua

print "emitted Lua for recursion:"
print compile(programs[3].source).lua

-- What the stages refuse.
local reason = attempt -> (select(2, pcall attempt):gsub("^[^:]*:%d+: ", ""))
print(reason(|| -> compile "(+ 1)"))
print(reason(|| -> compile "(+ 1 nothing)"))
print(reason(|| -> compile "(if 1 2)"))
print(reason(|| -> compile "(+ 1 2"))
local forgetful = { ..Unchanged }
forgetful.Closure = nil
print(reason(|| -> Instruction.pass "a pass that forgets a kind" forgetful))

--[=[ output
a constant condition folds away: compiled 16, evaluated 16, 16 -> 2 instructions
a function and a call: compiled 49, evaluated 49, 9 -> 7 instructions
recursion: compiled 3628800, evaluated 3628800, 19 -> 18 instructions
a closure: compiled 7, evaluated 7, 11 -> 11 instructions
instructions before optimizing:
  value_1 = 1
  value_2 = 2
  value_3 = value_1 < value_2
  jump otherwise_4 unless value_3
  value_7 = 10
  value_8 = 2
  value_9 = 3
  value_10 = value_8 * value_9
  value_11 = value_7 + value_10
  value_6 = value_11
  jump done_5
  otherwise_4:
  value_12 = 99
  value_6 = value_12
  done_5:
  return value_6
after:
  value_6 = 16
  return value_6
emitted Lua:
local value_6
value_6 = 16
return value_6
emitted Lua for recursion:
local lambda_13, fact_1, value_14, value_15
lambda_13 = function(n_2)
  local value_3, value_4, value_7, value_9, value_10, value_11, value_12
  value_3 = 2
  value_4 = n_2 < value_3
  if not value_4 then goto otherwise_5 end
  value_7 = 1
  goto done_6
  ::otherwise_5::
  value_9 = 1
  value_10 = n_2 - value_9
  value_11 = fact_1(value_10)
  value_12 = n_2 * value_11
  value_7 = value_12
  ::done_6::
  return value_7
end
fact_1 = lambda_13
value_14 = 10
value_15 = fact_1(value_14)
return value_15
check: (+) takes two arguments, got 1
check: nothing is not defined here
parse: (if condition when-true when-false) takes three parts
read: a ( is never closed
pass 'a pass that forgets a kind': no handler for the kind 'Closure' of the family 'instruction of the intermediate form'
]=]
