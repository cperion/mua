-- A small Lisp, compiled to Lua: read, parse to a syntax tree, check, lower to instructions,
-- optimize, emit. Two closed families (the syntax and the instructions) and a pass over one of
-- them for every stage; passes are vocabularies, so they share and extend one another by spread.
-- docs/writing-compilers.md builds the same compiler step by step, with source positions and
-- every problem reported at once.
--   luajit mua.lua examples/lisp.mua

------------------------------------------------------------------------------------------------
-- Reading: text to data. A number is a number, a symbol a string, a list a table.

local read = do(text)
    local spaced = text:gsub("%(", " ( "):gsub("%)", " ) ")
    local tokens = {}
    for token in spaced:gmatch "%S+" do tokens[#tokens + 1] = token end
    local position = 1
    local read_datum
    read_datum = do()
        local token = tokens[position]
        position += 1
        if token == nil then error("read: the text ends inside a list", 0) end
        if token == ")" then error("read: a ) closes nothing", 0) end
        if token ~= "(" then return tonumber token or token end
        local items = {}
        while tokens[position] ~= ")" do
            if tokens[position] == nil then error("read: a ( is never closed", 0) end
            items[#items + 1] = read_datum()
        end
        position += 1
        return items
    end
    local forms = {}
    while tokens[position] ~= nil do forms[#forms + 1] = read_datum() end
    return forms
end

------------------------------------------------------------------------------------------------
-- The source language: a family of expression kinds.

local Expression = family "expression of the source language"
local Literal = struct { value: Number }
local Variable = struct { name: String }
local Primitive = struct { operator: String, arguments: Table }
local Conditional = struct { condition: Expression, when_true: Expression, when_false: Expression }
local Let = struct { name: String, value: Expression, body: Expression }
local Lambda = struct { parameters: Table, body: Expression }
local Application = struct { callee: Expression, arguments: Table }
Expression { Literal, Variable, Primitive, Conditional, Let, Lambda, Application }

local operators = {
    ["+"] = |left, right| -> left + right,
    ["-"] = |left, right| -> left - right,
    ["*"] = |left, right| -> left * right,
    ["<"] = |left, right| -> left < right,
    ["="] = |left, right| -> left == right,
}

-- Parsing: data to the family. A `let` binding sees itself, so a function can recur.
local parse
parse = do(datum)
    if type datum == "number" then return Literal { value = datum } end
    if type datum == "string" then return Variable { name = datum } end
    local head = datum[1]
    if head == "if" then
        if #datum ~= 4 then
            error("parse: (if condition when-true when-false) takes three parts", 0)
        end
        return Conditional with
            condition = parse datum[2]
            when_true = parse datum[3]
            when_false = parse datum[4]
        end
    end
    if head == "let" then
        local body = parse datum[3]
        for index = #datum[2], 1, -1 do
            local binding = datum[2][index]
            body = Let { name = binding[1], value = parse binding[2], .body }
        end
        return body
    end
    if head == "lambda" then return Lambda { parameters = datum[2], body = parse datum[3] } end
    local arguments = {}
    for index = 2, #datum do arguments[#arguments + 1] = parse datum[index] end
    if operators[head] then return Primitive { operator = head, .arguments } end
    return Application { callee = parse datum[1], .arguments }
end

-- A program is some (define name value) forms and then the expression they are for.
local parse_program = do(forms)
    local body = parse forms[#forms]
    for index = #forms - 1, 1, -1 do
        local form = forms[index]
        if form[1] ~= "define" then error("parse: only the last form may be an expression", 0) end
        body = Let { name = form[2], value = parse form[3], .body }
    end
    return body
end

------------------------------------------------------------------------------------------------
-- Checking: a pass that carries the names in scope, and stops at the first problem.

local within = outer -> meta { index = outer } {}
local scope_with = do(outer, names)
    local inner = within outer
    for _, name in ipairs names do inner[name] = true end
    return inner
end

local Checking = define
    Literal = do(node, recurse, scope)
        return
    end
    Variable = do(node, recurse, scope)
        if not scope[node.name] then error("check: " .. node.name .. " is not defined here",
                0) end
    end
    Primitive = do(node, recurse, scope)
        if #node.arguments ~= 2 then
            local message = ("(%s) takes two arguments, got %d"):format(node.operator,
                #node.arguments)
            error("check: " .. message, 0)
        end
        for _, argument in ipairs node.arguments do recurse(argument, scope) end
    end
    Conditional = do(node, recurse, scope)
        recurse(node.condition, scope)
        recurse(node.when_true, scope)
        recurse(node.when_false, scope)
    end
    Let = do(node, recurse, scope)
        local inner = scope_with(scope, { node.name })
        recurse(node.value, inner)
        recurse(node.body, inner)
    end
    Lambda = do(node, recurse, scope)
        recurse(node.body, scope_with(scope, node.parameters))
    end
    Application = do(node, recurse, scope)
        recurse(node.callee, scope)
        for _, argument in ipairs node.arguments do recurse(argument, scope) end
    end
end
local check = Expression.pass "check names and arity" with ..Checking end

-- The same family, run directly: the reference the compiled code is compared with.
local Evaluation = define
    Literal = |node, recurse, environment| -> node.value
    Variable = |node, recurse, environment| -> environment[node.name]
    Primitive = do(node, recurse, environment)
        local left = recurse(node.arguments[1], environment)
        local right = recurse(node.arguments[2], environment)
        return operators[node.operator](left, right)
    end
    Conditional = do(node, recurse, environment)
        if recurse(node.condition, environment) then
            return recurse(node.when_true, environment)
        end
        return recurse(node.when_false, environment)
    end
    Let = do(node, recurse, environment)
        local inner = within environment
        inner[node.name] = recurse(node.value, inner)
        return recurse(node.body, inner)
    end
    Lambda = do(node, recurse, environment) = do(..arguments)
        local inner = within environment
        for index, name in ipairs node.parameters do inner[name] = arguments[index] end
        return recurse(node.body, inner)
    end
    Application = do(node, recurse, environment)
        local arguments = {}
        for index, argument in ipairs node.arguments do
            arguments[index] = recurse(argument, environment)
        end
        return recurse(node.callee, environment)(unpack arguments)
    end
end
local evaluate = Expression.pass "evaluate the source directly" with ..Evaluation end

------------------------------------------------------------------------------------------------
-- The intermediate form: registers and jumps, one list of instructions per function.

local Instruction = family "instruction of the intermediate form"
local Constant = struct { register: String, value: Any }
local Copy = struct { register: String, source: String }
local Operation = struct { register: String, operator: String, left: String, right: String }
local Call = struct { register: String, callee: String, arguments: Table }
local Label = struct { name: String }
local Jump = struct { label: String }
local JumpUnless = struct { condition: String, label: String }
local Return = struct { source: String }
local Closure = struct { register: String, parameters: Table, code: Table }
Instruction { Constant, Copy, Operation, Call, Label, Jump, JumpUnless, Return, Closure }

-- fresh names say what a register holds: `value_3`, `fact_1` (the register of `fact`), `otherwise_4`
local fresh_names = do()
    local count = 0
    return do(word)
        count += 1
        return word:gsub("[^%w_]", "_") .. "_" .. count
    end
end

local write_instruction = do(lowering, instruction)
    lowering.code[#lowering.code + 1] = instruction
end

-- Lowering: a pass from one family to the other. The lowering state holds the code being written,
-- the register each name stands for, and the supply of fresh names.
local Lowering = define
    Literal = do(node, recurse, lowering)
        local register = lowering.fresh "value"
        write_instruction(lowering, Constant { .register, value = node.value })
        return register
    end
    Variable = |node, recurse, lowering| -> lowering.registers[node.name]
    Primitive = do(node, recurse, lowering)
        local left = recurse(node.arguments[1], lowering)
        local right = recurse(node.arguments[2], lowering)
        local register = lowering.fresh "value"
        local operator = node.operator
        write_instruction(lowering, Operation { .register, .operator, .left, .right })
        return register
    end
    Conditional = do(node, recurse, lowering)
        local condition = recurse(node.condition, lowering)
        local otherwise = lowering.fresh "otherwise"
        local done = lowering.fresh "done"
        local register = lowering.fresh "value"
        write_instruction(lowering, JumpUnless { .condition, label = otherwise })
        write_instruction(lowering,
            Copy { .register, source = recurse(node.when_true, lowering) })
        write_instruction(lowering, Jump { label = done })
        write_instruction(lowering, Label { name = otherwise })
        write_instruction(lowering,
            Copy { .register, source = recurse(node.when_false, lowering) })
        write_instruction(lowering, Label { name = done })
        return register
    end
    Let = do(node, recurse, lowering)
        local register = lowering.fresh node.name
        local inner = { ..lowering, registers = within lowering.registers }
        inner.registers[node.name] = register
        write_instruction(lowering, Copy { .register, source = recurse(node.value, inner) })
        return recurse(node.body, inner)
    end
    Lambda = do(node, recurse, lowering)
        local inner = { ..lowering, code = {}, registers = within lowering.registers }
        local parameters = {}
        for index, name in ipairs node.parameters do
            parameters[index] = lowering.fresh name
            inner.registers[name] = parameters[index]
        end
        write_instruction(inner, Return { source = recurse(node.body, inner) })
        local register = lowering.fresh "lambda"
        write_instruction(lowering, Closure { .register, .parameters, code = inner.code })
        return register
    end
    Application = do(node, recurse, lowering)
        local callee = recurse(node.callee, lowering)
        local arguments = {}
        for index,
        argument in ipairs node.arguments do arguments[index] = recurse(argument, lowering) end
        local register = lowering.fresh "value"
        write_instruction(lowering, Call { .register, .callee, .arguments })
        return register
    end
end
local lower = Expression.pass "lower the source to instructions" with ..Lowering end

-- Optimizing. A rewrite answers each instruction with the instructions that replace it, so
-- `Unchanged` (every instruction stands for itself) is the base the others extend by spread, and
-- each names only the kinds it changes.
-- Both strategies use these exact passes. Only the replacement protocol and its
-- driver vary; the eager example keeps lists, the pull companion returns triples.
local eager_rewrite = do(pass, code, state)
    local written = {}
    local work = { ..state, .written }
    for _, instruction in ipairs code do
        for _, replacement in ipairs(pass(instruction, work)) do
            written[#written + 1] = replacement
        end
    end
    return written
end

local make_optimizer = do(single, empty, rewrite)
    local itself = single
    local Unchanged = define
        Constant = itself
        Copy = itself
        Operation = itself
        Call = itself
        Label = itself
        Jump = itself
        JumpUnless = itself
        Return = itself
        Closure = itself
    end
    local nothing = do() end

    -- The driver owns written; nested rewrites receive independent output buffers.
    local walk = do(pass, code, state)
        for _, instruction in ipairs code do pass(instruction, state) end
    end

    -- Folding: what a register holds is known from its Constant, along straight-line code. A join
    -- point (a label) forgets it, and a function starts knowing nothing.
    local Folding = define ..Unchanged
        Constant = do(node, recurse, facts)
            facts.known[node.register] = { node.value }
            return single node
        end
        Copy = do(node, recurse, facts)
            local known = facts.known[node.source]
            facts.known[node.register] = known
            if known then return single(Constant { register = node.register, value = known[1] }) end
            return single node
        end
        Operation = do(node, recurse, facts)
            local left, right = facts.known[node.left], facts.known[node.right]
            facts.known[node.register] = nil
            if left and right then
                local value = operators[node.operator](left[1], right[1])
                facts.known[node.register] = { value }
                return single(Constant { register = node.register, .value })
            end
            return single node
        end
        Call = do(node, recurse, facts)
            facts.known[node.register] = nil
            return single node
        end
        Label = do(node, recurse, facts)
            facts.known = {}
            return single node
        end
        JumpUnless = do(node, recurse, facts)
            local condition = facts.known[node.condition]
            if condition == nil then return single node end
            if condition[1] then return empty() end
            return single(Jump { label = node.label })
        end
        Closure = do(node, recurse, facts)
            facts.known[node.register] = nil
            local code = rewrite(recurse, node.code, { known = {} })
            return single(Closure { register = node.register, parameters = node.parameters, .code })
        end
    end
    local fold = Instruction.pass "fold what is known" with ..Folding end

    -- Which labels are still jumped to.
    local JumpedTo = define
        Constant = nothing
        Copy = nothing
        Operation = nothing
        Call = nothing
        Label = nothing
        Return = nothing
        Jump = do(node, recurse, labels)
            labels[node.label] = true
        end
        JumpUnless = do(node, recurse, labels)
            labels[node.label] = true
        end
        Closure = do(node, recurse, labels)
            walk(recurse, node.code, labels)
        end
    end
    local find_labels = Instruction.pass "find the labels still jumped to" with ..JumpedTo end

    -- Reaching: nothing runs between a jump and the next label that is jumped to, and a jump to the
    -- label right after it is no jump.
    local unless_dead = do(node, recurse, flow)
        if flow.dead then return empty() end
        return single node
    end
    local ending_the_flow = do(node, recurse, flow)
        if flow.dead then return empty() end
        flow.dead = true
        return single node
    end
    local Reaching = define
        Constant = unless_dead
        Copy = unless_dead
        Operation = unless_dead
        Call = unless_dead
        JumpUnless = unless_dead
        Jump = ending_the_flow
        Return = ending_the_flow
        Label = do(node, recurse, flow)
            if not flow.labels[node.name] then return empty() end
            local previous = flow.written[#flow.written]
            if previous and Instruction.is(previous, Jump) and previous.label == node.name then
                flow.written[#flow.written] = nil
            end
            flow.dead = false
            return single node
        end
        Closure = do(node, recurse, flow)
            if flow.dead then return empty() end
            local code = rewrite(recurse, node.code, { labels = flow.labels })
            return single(Closure { register = node.register, parameters = node.parameters, .code })
        end
    end
    local reach = Instruction.pass "drop what cannot run" with ..Reaching end

    -- Reading: how often each register is read, then the removal of pure instructions nobody reads.
    local read_once_more = do(register, counts)
        counts.reads[register] = (counts.reads[register] or 0) + 1
    end
    local Reads = define
        Constant = nothing
        Label = nothing
        Jump = nothing
        Copy = do(node, recurse, counts)
            read_once_more(node.source, counts)
        end
        Operation = do(node, recurse, counts)
            read_once_more(node.left, counts)
            read_once_more(node.right, counts)
        end
        Call = do(node, recurse, counts)
            read_once_more(node.callee, counts)
            for _, argument in ipairs node.arguments do read_once_more(argument, counts) end
        end
        JumpUnless = do(node, recurse, counts)
            read_once_more(node.condition, counts)
        end
        Return = do(node, recurse, counts)
            read_once_more(node.source, counts)
        end
        Closure = do(node, recurse, counts)
            walk(recurse, node.code, counts)
        end
    end
    local count_reads = Instruction.pass "count the reads of each register" with ..Reads end

    local never_read = |instruction, counts| -> (counts.reads[instruction.register] or 0) == 0
    local unless_never_read = do(node, recurse, counts)
        if never_read(node, counts) then return empty() end
        return single node
    end
    local Sweeping = define ..Unchanged
        Constant = unless_never_read
        Copy = unless_never_read
        Operation = unless_never_read
        Closure = do(node, recurse, counts)
            if never_read(node, counts) then return empty() end
            local code = rewrite(recurse, node.code, counts)
            return single(Closure { register = node.register, parameters = node.parameters, .code })
        end
    end
    local sweep = Instruction.pass "sweep what nobody reads" with ..Sweeping end

    -- the same representation: the same kinds, with the same fields, all the way down
    local same
    same = do(left, right)
        if type left ~= "table" or type right ~= "table" then return left == right end
        if getmetatable left ~= getmetatable right then return false end
        for key, value in pairs left do
            if not same(value, right[key]) then return false end
        end
        for key in pairs right do
            if left[key] == nil then return false end
        end
        return true
    end

    local instruction_count
    instruction_count = do(code)
        local total = 0
        for _, instruction in ipairs code do
            total += 1
            if Instruction.is(instruction, Closure) then total += instruction_count instruction.code end
        end
        return total
    end

    -- the passes in order until a round changes nothing, bounded so a mistake cannot loop forever
    local optimize = do(code)
        for _ = 1, 8 do
            local before = code
            code = rewrite(fold, code, { known = {} })
            local labels = {}
            walk(find_labels, code, labels)
            code = rewrite(reach, code, { .labels })
            local counts = { reads = {} }
            walk(count_reads, code, counts)
            code = rewrite(sweep, code, counts)
            if same(code, before) then break end
        end
        return code
    end
    return { .optimize, .same, .instruction_count, .Unchanged }
end

local eager = make_optimizer(node -> { node }, || -> {}, eager_rewrite)
local optimize = eager.optimize
local instruction_count = eager.instruction_count
local Unchanged = eager.Unchanged

------------------------------------------------------------------------------------------------
-- Listing and emitting: passes that answer with text.

local Listing = define
    Constant = |node, recurse, indent| -> indent .. node.register .. " = " .. tostring node.value
    Copy = |node, recurse, indent| -> indent .. node.register .. " = " .. node.source
    Operation = do(node, recurse, indent)
        local expression = node.left .. " " .. node.operator .. " " .. node.right
        return indent .. node.register .. " = " .. expression
    end
    Call = do(node, recurse, indent)
        local arguments = table.concat(node.arguments, ", ")
        return indent .. node.register .. " = " .. node.callee .. "(" .. arguments .. ")"
    end
    Label = |node, recurse, indent| -> indent .. node.name .. ":"
    Jump = |node, recurse, indent| -> indent .. "jump " .. node.label
    JumpUnless = |node, recurse, indent| -> indent .. "jump " .. node.label .. " unless " .. node.condition
    Return = |node, recurse, indent| -> indent .. "return " .. node.source
    Closure = do(node, recurse, indent)
        local parameters = table.concat(node.parameters, ", ")
        local lines = { indent .. node.register .. " = function(" .. parameters .. ")" }
        for _,
        instruction in ipairs node.code do lines[#lines + 1] = recurse(instruction,
                indent .. "    ") end
        return table.concat(lines, "\n")
    end
end
local list_instruction = Instruction.pass "list an instruction for reading" with ..Listing end
local listing = do(code)
    local lines = {}
    for _, instruction in ipairs code do lines[#lines + 1] = list_instruction(instruction, "  ") end
    return table.concat(lines, "\n")
end

-- Emitting Lua: the registers a function writes are declared first, so a jump never enters the
-- scope of a local. The listing's spelling serves where Lua's is the same.
local function_body = do(write, code, indent)
    local registers, declared = {}, {}
    for _, instruction in ipairs code do
        local register = instruction.register
        if register and not declared[register] then
            declared[register] = true
            registers[#registers + 1] = register
        end
    end
    local lines = {}
    if #registers > 0 then lines[1] = indent .. "local " .. table.concat(registers, ", ") end
    for _, instruction in ipairs code do lines[#lines + 1] = write(instruction, indent) end
    return table.concat(lines, "\n")
end
local lua_spelling = {["="] = "==" }
local LuaText = define ..Listing
    Operation = do(node, recurse, indent)
        local operator = lua_spelling[node.operator] or node.operator
        local expression = node.left .. " " .. operator .. " " .. node.right
        return indent .. node.register .. " = " .. expression
    end
    Label = |node, recurse, indent| -> indent .. "::" .. node.name .. "::"
    Jump = |node, recurse, indent| -> indent .. "goto " .. node.label
    JumpUnless = |node, recurse, indent| -> indent .. "if not " .. node.condition .. " then goto " .. node.label .. " end"
    Closure = do(node, recurse, indent)
        local parameters = table.concat(node.parameters, ", ")
        local header = indent .. node.register .. " = function(" .. parameters .. ")"
        local body = function_body(recurse, node.code, indent .. "  ")
        return header .. "\n" .. body .. "\n" .. indent .. "end"
    end
end
local write_lua = Instruction.pass "write an instruction as Lua" with ..LuaText end
local emit_lua = code -> function_body(write_lua, code, "")

------------------------------------------------------------------------------------------------
-- The compiler: the stages in order. `compile` answers the tree, the instructions before and
-- after optimizing, and the Lua it emits.

local make_compiler = do(read_source, optimize_code) = do(text)
    local tree = parse_program(read_source text)
    check(tree, {})
    local lowering = { code = {}, registers = {}, fresh = fresh_names() }
    write_instruction(lowering, Return { source = lower(tree, lowering) })
    local optimized = optimize_code lowering.code
    return { .tree, instructions = lowering.code, .optimized, lua = emit_lua optimized }
end
local compile = make_compiler(read, optimize)

-- The companion and benchmarks load this file as a library, sharing the families,
-- all language decisions, and every pass. Running it normally still prints the demo.
if (...) == "library" then
    return { .read, .parse_program, .check, .evaluate, .make_optimizer, .make_compiler,
        .compile,
        .optimize, .emit_lua, .listing, .instruction_count, .eager_rewrite, same = eager.same }
end

local run = do(text)
    local compiled = compile text
    local value = load(compiled.lua, "=compiled")()
    return value, evaluate(compiled.tree, {}), compiled
end

local programs = {
    { title = "a constant condition folds away", source = "(if (< 1 2) (+ 10 (* 2 3)) 99)" },
    { title = "a function and a call",
        source = "(define square (lambda (x) (* x x))) (square (+ 3 4))" },
    { title = "recursion",
        source = "(define fact (lambda (n) (if (< n 2) 1 (* n (fact (- n 1)))))) (fact 10)" },
    { title = "a closure",
        source = "(define adder (lambda (a) (lambda (b) (+ a b)))) ((adder 3) 4)" },
}
for _, program in ipairs programs do
    local compiled_value, evaluated_value, compiled = run program.source
    local before = instruction_count compiled.instructions
    local after = instruction_count compiled.optimized
    local values = ("compiled %s, evaluated %s"):format(tostring compiled_value,
        tostring evaluated_value)
    print(("%s: %s, %d -> %d instructions"):format(program.title, values, before, after))
end

local folded = compile programs[1].source
print "instructions before optimizing:"
print(listing folded.instructions)
print "after:"
print(listing folded.optimized)
print "emitted Lua:"
print folded.lua

print "emitted Lua for recursion:"
print compile(programs[3].source).lua

-- What the stages refuse.
local reason = attempt -> (select(2, pcall attempt):gsub("^[^:]*:%d+: ", ""))
print(reason(|| -> compile "(+ 1)"))
print(reason(|| -> compile "(+ 1 nothing)"))
print(reason(|| -> compile "(if 1 2)"))
print(reason(|| -> compile "(+ 1 2"))
local forgetful = { ..Unchanged }
forgetful.Closure = nil
print(reason(|| -> Instruction.pass "a pass that forgets a kind" forgetful))

--[=[ output
a constant condition folds away: compiled 16, evaluated 16, 16 -> 2 instructions
a function and a call: compiled 49, evaluated 49, 9 -> 7 instructions
recursion: compiled 3628800, evaluated 3628800, 19 -> 18 instructions
a closure: compiled 7, evaluated 7, 11 -> 11 instructions
instructions before optimizing:
  value_1 = 1
  value_2 = 2
  value_3 = value_1 < value_2
  jump otherwise_4 unless value_3
  value_7 = 10
  value_8 = 2
  value_9 = 3
  value_10 = value_8 * value_9
  value_11 = value_7 + value_10
  value_6 = value_11
  jump done_5
  otherwise_4:
  value_12 = 99
  value_6 = value_12
  done_5:
  return value_6
after:
  value_6 = 16
  return value_6
emitted Lua:
local value_6
value_6 = 16
return value_6
emitted Lua for recursion:
local lambda_13, fact_1, value_14, value_15
lambda_13 = function(n_2)
  local value_3, value_4, value_7, value_9, value_10, value_11, value_12
  value_3 = 2
  value_4 = n_2 < value_3
  if not value_4 then goto otherwise_5 end
  value_7 = 1
  goto done_6
  ::otherwise_5::
  value_9 = 1
  value_10 = n_2 - value_9
  value_11 = fact_1(value_10)
