-- Application, lambdas and currying: the small forms everything else is built from.
--   luajit mua.lua examples/hello.mua

-- Application is juxtaposition: `greet "Mua"` is `greet("Mua")`.
local greet = do(name) = "hello, " .. name
print(greet "Mua")

-- It is curried: `add 2 3` is `add(2)(3)`, so a partial application is just a name.
local add = do(a) = do(b) = a + b
local increment = add 1
print(add 2 3, increment 41)

-- Short functions come from LuaJIT 3.0's syntax.
local double = x -> x * 2
local sum = |a, b| -> a + b
print(double 21, sum(40, 2))

-- Application binds tighter than operators, and a spaced group is the next argument.
print(add 1 2 + 10)
print(add 1 (2 * 3))

-- A conditional, a safe-navigation access and a default.
local config = { name = "mua" }
print(config.name == "mua" ? "named" : "anonymous")
print(config?.missing?.deep ?? "no value")
