-- Contracts, `struct` and `oneof`: checks at the edges, and choices that must be handled.
--   luajit mua.lua examples/contracts.mua

-- (an error may carry the file and line of its call; `reason` keeps just the reason)
local reason = message -> (tostring(message):gsub("^[^:]+:%d+: ", ""))
local failure = f -> reason(select(2, pcall f))

-- An annotation is a contract, checked when the function is called and when it returns.
local area = do(width: Number, height: Number): Number = width * height
print(area(3, 4))
print(failure(|| -> area("3", 4)))

-- A struct is a closed record with typed fields.
local Point = struct { x: Number, y: Number }
local origin = Point { x = 0, y = 0 }
print(origin.x, origin.y)
print(failure(|| -> Point { x = 1 }))
print(failure(|| -> Point { x = 1, y = 2, z = 3 }))

-- Its instances reach their methods through the struct.
function Point:distance_squared()
    return self.x * self.x + self.y * self.y
end
print(Point { x = 3, y = 4 }:distance_squared())

-- A struct is a checker, so it works as a contract.
local length_squared = do(p: Point): Number = p:distance_squared()
print(length_squared(Point { x = 6, y = 8 }))
print(failure(|| -> length_squared { x = 6, y = 8 }))

-- A oneof is a closed set of alternatives, each with a payload.
local Shape = oneof { circle: Number, rect: Table, dot: Unit }

-- A value is matched by calling it with one handler per alternative.
local area_of = do(shape: Shape): Number = shape with
    circle = r -> 3 * r * r
    rect = t -> t.w * t.h
    dot = || -> 0
end
print(area_of(Shape.circle 2), area_of(Shape.rect { w = 2, h = 5 }), area_of(Shape.dot()))

-- Every match checks that the handlers are exactly the alternatives.
print(failure(|| -> Shape.dot() { circle = r -> r }))
print(failure(|| -> Shape.dot() with
    circle = r -> r
    rect = t -> 0
    dot = || -> 0
    line = || -> 0
end))

-- A payload is checked when the alternative is built.
print(failure(|| -> Shape.circle "wide"))

--[=[ output
12
contract: parameter 'width' of area expects Number, got a string "3"
0	0
contract: the field 'y' of Point expects Number, got nil
Point has no field 'z'
25
100
contract: parameter 'p' of length_squared expects Point, got a table
12	10	0
matching a Shape: the alternative 'rect' has no handler
Shape has no alternative 'line' to handle
contract: the payload of Shape.circle expects Number, got a string "wide"
]=]
