-- Accounting and documentation-syntax guards only. Behavior lives in the activity regressions.
local Widgets = require "bui.ui.widgets"
local read = do(path)
    local file = assert(io.open(path, "rb"))
    local contents = file:read "*a"
    file:close
    return contents
end
local public = name -> name:match "^BK_" or name:match "^BUI_" or name:match "^GPU_" or name:match "^bui_"
local declared, inventory, count = {}, {}, 0
for name in read("bui/cdef.lua"):gmatch "([%a_][%w_]*)%s*%(" do
    if public name then declared[name] = true end
end
local document = read "docs/bui-coverage.md"
local ledger = assert(document:match "## Native function ledger(.*)")
for block in ledger:gmatch "```text\n(.-)```" do
    for name in block:gmatch "%S+" do
        assert(public name and declared[name], "unknown audited function: " .. name)
        assert(not inventory[name], "duplicate audited function: " .. name)
        inventory[name] = true
        count += 1
    end
end
for name in pairs declared do assert(inventory[name], "missing capability accounting: " .. name) end
assert(count == 296, "review the locked native interface when its size changes")
local kinds, total = assert(document:match "### All native node kinds(.-)## Native policy"), 0
local listed = {}
for name in assert(kinds:match "```text\n(.-)```"):gmatch "%S+" do listed[name] = true end
for _, descriptor in pairs Widgets.catalog do
    assert(listed[descriptor.kind], "missing node-kind accounting: " .. descriptor.kind)
    listed[descriptor.kind] = nil
    total += 1
end
assert(next listed == nil and total == 48, "review the native node catalog")
print("BUI coverage inventory: " .. count .. " native functions, " .. total .. " node kinds accounted for")
local Compiler, snippets = require "mua.init", 0
for _, path in ipairs { "docs/bui-activities.md", "docs/bui-ui.md", "docs/bui-coverage.md" } do
    for language, code in read(path):gmatch "```([%w_-]+)[^\n]*\n(.-)\n```" do
        if language == "mua" then
            snippets += 1
            local source = path .. ":block-" .. snippets
            assert(loadstring(Compiler.translate(code, source), source))
        end
    end
end
assert(snippets >= 2, "missing implemented API examples")
print("BUI documentation: " .. snippets .. " Mua blocks parsed and compiled")
