-- Pure drawing-list assembly. The canvas consumer checks descriptions again at publication.
local Canvas = require "bui.ui.canvas"

-- Collect checked shape descriptions; returning from the body acquires no native resources.
local drawing = do(body: Function): Table
    local descriptions, Drawing, identifiers = {}, {}, {}
    local active = true
    for kind in pairs Canvas.kinds do
        Drawing[kind] = do(options)
            assert(active, "drawing description activity has ended")
            local description = Canvas.describe(kind, options, #descriptions + 1)
            assert(not identifiers[description.id], "duplicate drawing item id")
            identifiers[description.id] = true
            descriptions[#descriptions + 1] = description
            return description.id
        end
    end
    local succeeded, problem = pcall(body, Drawing)
    active = false
    if not succeeded then error(problem, 0) end
    return descriptions
end

return define .drawing end
