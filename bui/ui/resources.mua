local Media = require "bui.ui.media"
local Raster = require "bui.ui.raster"
local Textures = require "bui.ui.textures"
local Typography = require "bui.ui.typography"
local Pixels = require "bui.ui.pixels"

-- Compose resource activities over one owner; copying the vocabulary never transfers a resource.
local for_owner = |Application, owner| -> define
    ..Media.resources(Application, owner)
    ..Raster.resources(Application, owner)
    ..Textures.resources(Application, owner)
    ..Typography.resources(Application, owner)
    ..Pixels.for_owner(Application, owner)
end

return define .for_owner end
