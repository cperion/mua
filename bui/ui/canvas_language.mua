-- The checked canvas language is independent of native storage and publication.
-- Its source syntax remains the documented flat drawing descriptions.
local Shape = family "canvas shape"
local ImageSource = oneof { path: String, pixels: Table, image: Any, video: Any }
local Rectangle = struct { id: Number, coordinates: Table, paint: Table }
local Oval = struct { id: Number, coordinates: Table, paint: Table }
local Line = struct { id: Number, coordinates: Table, paint: Table }
local Polygon = struct { id: Number, coordinates: Table, paint: Table }
local Text = struct
    id: Number
    coordinates: Table
    paint: Table
    text: String
    font: Table
    anchor: Number
end
local Arc = struct { id: Number, coordinates: Table, paint: Table, start: Number, extent: Number }
local Image = struct
    id: Number
    coordinates: Table
    paint: Table
    source: ImageSource
    fit: String
    frame: Number
end
local RoundRectangle = struct { id: Number, coordinates: Table, paint: Table, radius: Number }
Shape { Rectangle, Oval, Line, Polygon, Text, Arc, Image, RoundRectangle }

local common = description -> { id = description.id, coordinates = description.coordinates,
    paint = { fill = description.fill, outline = description.outline, width = description.width,
        hidden = description.hidden, clip = description.clip } }
local primitive = Constructor -> description -> Constructor(common description)
local Reading = define
    rectangle = do(description)
        if description.radius > 0 then
            return RoundRectangle { ..common description, radius = description.radius }
        end
        return Rectangle(common description)
    end
    oval = primitive Oval
    line = primitive Line
    polygon = primitive Polygon
    text = description -> Text with ..common description
        text = description.text
        anchor = description.anchor
        font = { family = description.family,
            size = description.size, flags = description.text_flags }
    end
    arc = description -> Arc with ..common description
        start = description.start
        extent = description.extent
    end
    image = do(description)
        local source
        if description.source then source = ImageSource.path description.source
        elseif description.image then source = ImageSource.image description.image
        elseif description.video then source = ImageSource.video description.video
        else source = ImageSource.pixels with
            bytes = description.rgba
            width = description.image_width
            height = description.image_height
        end end
        return Image with ..common description
            .source
            fit = description.fit
            frame = description.frame
        end
    end
    round_rectangle = description -> RoundRectangle with ..common description
        radius = description.radius
    end
end

-- Semantic checking precedes this projection; each resulting kind has only its own operands.
local read = description -> assert(Reading[description.kind], "unknown canvas shape")(description)
local coordinates = do(node)
    local copied = {}
    for index, value in ipairs node.coordinates do copied[index] = value end
    return copied
end
local write_attributes = do(node, kind)
    local copy = do(values)
        if not values then return nil end
        local result = {}
        for index, value in ipairs values do result[index] = value end
        return result
    end
    return { .kind, id = node.id, coordinates = coordinates node,
        fill = copy node.paint.fill, outline = copy node.paint.outline,
        width = node.paint.width, hidden = node.paint.hidden, clip = copy node.paint.clip }
end
local writing = kind -> |node, recurse| -> write_attributes(node, kind)
local Writing = define
    Rectangle = writing "rectangle"
    Oval = writing "oval"
    Line = writing "line"
    Polygon = writing "polygon"
    Text = |node, recurse| -> { ..write_attributes(node, "text"),
        text = node.text, family = node.font.family,
        size = node.font.size, text_flags = node.font.flags, anchor = node.anchor }
    Arc = |node, recurse| -> { ..write_attributes(node, "arc"),
        start = node.start, extent = node.extent }
    Image = do(node, recurse)
        local source = node.source with
            path = path -> { source = path }
            pixels = pixels -> { rgba = pixels.bytes,
                image_width = pixels.width, image_height = pixels.height }
            image = image -> { .image }
            video = video -> { .video }
        end
        return { ..write_attributes(node, "image"), ..source, fit = node.fit, frame = node.frame }
    end
    RoundRectangle = |node, recurse| -> { ..write_attributes(node, "round_rectangle"),
        radius = node.radius }
end
local write = Shape.pass "write a canvas shape as supplied data" with ..Writing end

return define .Shape, .ImageSource, .read, .write end
