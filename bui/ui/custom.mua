local ffi = require "ffi"
local Check = require "bui.ui.check"
local Scope = require "bui.ui.scope"
local Raster = require "bui.ui.raster"
local Behavior = require "bui.ui.behavior"

if jit then jit.off(true, true) end

local cursors = { default = 0, horizontal = 1, vertical = 2, text = 3, crosshair = 4,
    hand = 5, move = 6, hidden = 7, northeast = 8, northwest = 9, forbidden = 10,
    wait = 11, progress = 12 }
local pools = meta { mode = "k" } {}
local packed = do(..values) = values

-- Response instructions may answer native input and schedule a later outward notification.
-- They cannot mount, dispose, or enter dispatch. Their borrow ends even when the body fails.
local responding = do(registration) = do(body)
    Check.callable(body, "custom response instructions")
    local active = true
    local record = registration.record
    local check = do()
        record.owner.check "custom response"
        assert(active and registration.owner.is_alive(), "custom service activity has ended")
    end
    local request_frame = do(milliseconds)
        check
        record.native.BK_custom_request_frame(record.node,
            Check.integer(Check.default(milliseconds, 0), "frame delay", 0, 2147483647))
    end
    local cursor = do(name)
        check
        local code = assert(cursors[name], "unknown cursor")
        record.native.BK_custom_set_cursor(record.node, code)
    end
    local invalidate = do() check; record.native.BK_node_invalidate record.node end
    local focused = do() check; return record.native.BK_custom_has_focus record.node ~= 0 end
    -- A notification function is an outward destination, not an activity body.
    -- Select that destination first; supplying its payload queues delivery.
    local notify_later = do(notification)
        check
        Check.callable(notification, "custom notification")
        return do(payload)
            check
            record.application.post(registration.owner, notification, payload)
        end
    end
    local results = packed(pcall(body, define
        .request_frame
        .cursor
        .focused
        .notify_later
        .invalidate
    end))
    active = false
    if not results[1] then error(results[2], 0) end
    return unpack(results, 2, results.n)
end

-- Frame preparation is not input service: it cannot change the cursor, answer focus, or queue
-- a user notification. Its closed return protocol decides whether another frame is needed.
local preparing = do(registration) = do(body)
    Check.callable(body, "custom frame instructions")
    local active = true
    local invalidate = do()
        assert(active and registration.owner.is_alive(), "frame preparation has ended")
        registration.record.native.BK_node_invalidate registration.record.node
    end
    local results = packed(pcall(body, define .invalidate end))
    active = false
    if not results[1] then error(results[2], 0) end
    return unpack(results, 2, results.n)
end

local snapshot = native_event -> with
    kind = Behavior.event_name native_event.type
    x = tonumber native_event.x
    y = tonumber native_event.y
    button = tonumber native_event.button
    modifiers = tonumber native_event.mods
    clicks = tonumber native_event.clicks
    horizontal = tonumber native_event.wheel_x
    vertical = tonumber native_event.wheel_y
    text = native_event.text ~= nil and ffi.string native_event.text or ""
    keysym = native_event.keysym ~= nil and ffi.string native_event.keysym or ""
end

local callbacks = do(Application)
    if pools[Application] then return pools[Application] end
    local event = Application.callback("int (*)(void *, BKNode *, const BKCustomEvent *)",
        do(token, _, native_event)
            local registration = Application.resolve token
            if not registration then return 0 end
            Behavior.event_name native_event.type
            local response = registration.responses[native_event.type]
            if not response then return 0 end
            local instructions = Check.callable(response(snapshot native_event),
                "custom response instructions")
            local decision = responding registration instructions
            return Application.protocols.consume_input decision and 1 or 0
        end, 0, "service")
    local frame = Application.callback("void (*)(void *, BKNode *)", do(token)
            local registration = Application.resolve token
            if not registration then return end
            local record = registration.record
            local again = false
            if registration.prepare then
                local decision = preparing registration registration.prepare
                again = Application.protocols.continue_frame decision
            end
            record.native.BK_node_invalidate record.node
            if again then record.native.BK_custom_request_frame(record.node, 0) end
        end, nil, "frame")
    local draw = Application.callback("void (*)(void *, BKNode *, BuiRaster *, const int *)",
        do(token, _, pointer, bounds)
            local registration = Application.resolve token
            if not registration or not registration.paint then return end
            local rectangle = { x = tonumber bounds[0], y = tonumber bounds[1],
                width = tonumber bounds[2], height = tonumber bounds[3] }
            local instructions = Check.callable(registration.paint rectangle,
                "custom painting instructions")
            local paint = Raster.borrow(Application, registration.owner, pointer)
            paint instructions
        end, nil, "draw")
    local Callbacks = define .event, .frame, .draw end
    pools[Application] = Callbacks
    Application.owner.defer do() pools[Application] = nil end
    return Callbacks
end

-- Publish a checked behavior description atomically. No legacy callback-bag contract:
-- the pure lowering pass decides the binding before this operation acquires anything.
local for_control = do(record)
    if record.kind ~= "custom" then return {} end
    local installed
    local behave = do(description)
        record.owner.mutate "install custom behavior"
        local binding = Behavior.lower description
        return Scope.prepare(record.owner, do()
                local lifetime = record.owner.child "custom behavior"
                local registration = { ..binding, owner = lifetime, .record }
                local token = record.application.register(lifetime, registration)
                local Callbacks = callbacks record.application
                local class = ffi.new "BKCustomClass[1]"
                class[0].event,
                class[0].frame, class[0].draw = Callbacks.event, Callbacks.frame, Callbacks.draw
                class[0].natural_w, class[0].natural_h = binding.width, binding.height
                lifetime.defer do()
                    if installed == lifetime then
                        record.native.BK_custom_set(record.node, nil, nil)
                        installed = nil
                    end
                end
                record.owner.mutate "publish custom behavior"
                assert(record.native.BK_custom_set(record.node, class, token) == 1,
                    "custom behavior refused")
                local previous = installed
                installed = lifetime
                lifetime.activate
                if previous then previous.close end
                return lifetime.close
            end)
    end
    local request_frame = do(milliseconds)
        record.owner.mutate "request custom frame"
        record.native.BK_custom_request_frame(record.node,
            Check.integer(Check.default(milliseconds, 0), "frame delay", 0, 2147483647))
    end
    local focused = do()
        record.owner.check "custom focus"
        return record.native.BK_custom_has_focus record.node ~= 0
    end
    local cursor = do(name)
        record.owner.mutate "custom cursor"
        local code = assert(cursors[name], "unknown cursor")
        record.native.BK_custom_set_cursor(record.node, code)
    end
    return define .behave, .request_frame, .focused, .cursor end
end

return define .for_control end
