-- Activity-based BUI, implemented in Mua. The raw C declarations remain in bui.ffi;
-- ownership, mounting, delivery and these closed protocols belong to this library.
local Application = require "bui.ui.application"
local Descriptions = require "bui.ui.descriptions"

local Opening = oneof { opened: Any, unavailable: String }
local Acquisition = oneof { ready: Any, unavailable: String }
local Frame = oneof { next_frame: Unit, finished: Unit }
local Selection = oneof { selected: Table, empty: Unit }
local Playback = oneof { loading: Unit, playing: Unit, paused: Unit, ended: Unit, failed: Unit }

local continue_frame = do(decision: Frame): Boolean
    return decision {
        next_frame() = true,
        finished() = false,
    }
end
local Protocols = define
    opening = Opening
    acquisition = Acquisition
    selection = Selection
    playback = Playback
    .continue_frame
end

-- Own the integration, all child activities, and their deterministic completion.
local activities = do(clock)
    return define
        with_application = do(Native)
            return do(body: Function): Any
                return Application.with_application(Native, Protocols, body, clock)
            end
        end
    end
end

-- Supply a monotonic seconds capability for deterministic tests or an embedding host.
-- This creates a vocabulary, not another dispatch engine or a global clock override.
local using_clock = do(clock: Function): Table
    return activities clock
end

return define
    ..activities(nil)
    ..Descriptions
    .Opening
    .Acquisition
    .Frame
    .Selection
    .Playback
    .using_clock
end
